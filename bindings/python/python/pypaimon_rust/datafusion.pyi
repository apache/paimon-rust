class BatchTableUpdate:
    def with_plan(self, plan: Plan) -> "BatchTableUpdate":
        """Reuse complete plan_all file groups for row-ID updates and deletes.

        Workers reauthorize against the table; a plan is metadata, not a grant.
        Selected row ranges, scores and streaming splits are not mutation plans.
        Other update operations reject this configuration before consuming input.
        """
        ...
    def with_blob_uri_reader_factory(
        self, factory: Optional[UriReaderFactory]
    ) -> "BatchTableUpdate": ...
    def merge_into(
        self, source: Optional[Union[pyarrow.Table, Table]], *, on: Sequence[Tuple[str, str]],
        when_matched: Sequence[Dict[str, Any]], when_not_matched: Sequence[Dict[str, Any]]
    ) -> List[CommitMessage]:
        """Prepare MERGE against one target snapshot. None selects self-merge on _ROW_ID.

        A Table source reads its selected snapshot or numeric timestamp window
        in core, independently of the target. Arrow input preserves batches and source row order.

        Clauses carry assignments as (column, source/target/literal/callable, value)
        tuples, a delete flag, and optional SQL condition metadata. Callables
        consume the complete clause's qualified t./s. Arrow columns and return
        an Array or ChunkedArray with the same row count; empty clauses are lazy.
        Commit returned messages through the matching builder's committer.
        """
        ...
    def update_by_predicate(
        self, predicate: Optional[Dict[str, Any]], assignments: Dict[str, Any],
        read_columns: Optional[Sequence[str]] = None
    ) -> List[CommitMessage]: ...
    def new_update_by_row_id(self) -> TableUpdateByRowId: ...
    def update_by_arrow_with_row_id(self, table: pyarrow.Table) -> List[CommitMessage]: ...
    def update_by_arrow_batches_with_row_id(
        self, tables: Iterable[pyarrow.Table]
    ) -> List[CommitMessage]: ...
    def new_shard_updator(
        self, shard_num: int, total_shard_count: int, *, read_type: Optional[str] = None
    ) -> ShardTableUpdator:
        """Create a shard operation with a Paimon ROW read type encoded as JSON.

        None reads all table fields; an empty ROW reads zero columns while
        preserving row counts. Read fields are independent of with_update_type.
        """
        ...
    def with_update_type(self, update_cols: List[str]) -> "BatchTableUpdate": ...
    def delete_by_row_id(self, row_ids: Sequence[int]) -> List[CommitMessage]: ...
    def delete_by_predicate(
        self, predicate: Optional[Dict[str, Any]]
    ) -> List[CommitMessage]:
        """Prepare partition metadata deletes or matching row deletion vectors in core."""
        ...
    def upsert_by_arrow_with_key(
        self, table: Union[pyarrow.Table, Sequence[pyarrow.RecordBatch]], upsert_keys: List[str]
    ) -> List[CommitMessage]:
        """Prepare one key upsert. Batches may have different non-key fields;
        appended rows in each partition must share a field set."""
        ...

