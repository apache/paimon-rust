        This method does not infer bucket counts for new input partitions.
        """
        ...
    def with_bucket_plan(self, plan: pyarrow.RecordBatch) -> "PostponeFixedBucketWriteBuilder":
        """Partition columns in schema order followed by total_buckets: int32.

        Counts must be positive and non-null. An explicit plan must contain
        every input partition; the table default does not fill missing entries.
        """
        ...
    def with_overwrite(self, static_partition: Optional[Dict[str, Any]] = {}) -> "PostponeFixedBucketWriteBuilder": ...
    def new_write(self) -> BatchTableWrite: ...
    def new_commit(self) -> BatchTableCommit: ...

